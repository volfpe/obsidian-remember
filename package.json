{
	"name": "obsidian-remember",
	"version": "0.0.20",
	"description": "Minimal, durable spaced repetition inside Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run lint && tsc --noEmit && node esbuild.config.mjs production",
		"lint": "npm run lint:code && npm run lint:css",
		"lint:code": "eslint .",
		"lint:css": "stylelint \"**/*.css\"",
		"release": "node scripts/release.mjs",
		"test": "vitest run",
		"version": "node scripts/version-bump.mjs"
	},
	"keywords": [
		"obsidian",
		"flashcards",
		"fsrs",
		"spaced-repetition"
	],
	"license": "MIT",
	"dependencies": {
		"ts-fsrs": "^5.2.1"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.15.17",
		"esbuild": "^0.25.8",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.11.0",
		"jiti": "^2.7.0",
		"jsdom": "^27.4.0",
		"obsidian": "^1.13.0",
		"obsidian-test-mocks": "^4.1.0",
		"stylelint": "^16.23.1",
		"stylelint-config-standard": "^39.0.0",
		"stylelint-no-unsupported-browser-features": "^8.1.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.67.0",
		"vitest": "^3.2.4"
	}
}
